---
layout: null
permalink: /rss.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ site.url }}{{ site.baseurl }}/</link>
    <description>{{ site.description | strip | xml_escape }}</description>
    <language>ko</language>
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    <atom:link href="{{ '/rss.xml' | absolute_url }}" rel="self" type="application/rss+xml"/>
    {%- for post in site.posts limit: 30 %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ post.url | absolute_url }}</link>
      <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      {%- assign desc = post.description | default: post.excerpt | strip_html | strip_newlines | truncate: 300 %}
      <description>{{ desc | xml_escape }}</description>
      {%- for c in post.categories %}
      <category>{{ c | xml_escape }}</category>
      {%- endfor %}
    </item>
    {%- endfor %}
  </channel>
</rss>
